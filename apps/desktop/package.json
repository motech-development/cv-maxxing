{
  "name": "@cv-maxxing/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/main/main.js",
  "type": "module",
  "scripts": {
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "tsc --project tsconfig.build.json",
    "build:renderer": "vite build",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "smoke": "pnpm build && playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.3",
    "electron": "^41.2.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
